<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve static files and directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback for localized Angular routes
  RewriteRule ^(en|en-US|fr|hi|ja|pt|th|zh-Hans|zh-Hant)/(.*)$ $1/index.html [L]
</IfModule>