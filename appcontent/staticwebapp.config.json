{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/ngsw.json",
      "/main.*.js",
      "/runtime.*.js",
      "/polyfills.*.js",
      "/styles.*.css",
      "/assets/*",
      "/media/*"
    ]
  },

  "routes": [
    {
      "route": "/media/*",
      "serve": "/media/:path",
      "allowedRoles": ["anonymous"]
    }
  ],

  "mimeTypes": {
    ".woff": "application/font-woff",
    ".woff2": "font/woff2"
  }

}